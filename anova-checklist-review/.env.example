# =============================================================================
# anova-checklist-review — environment template
# Copy to .env and adjust. Never commit real secrets.
# All values below are CONFIGURABLE; do not treat defaults as production facts.
# =============================================================================

COMPOSE_PROJECT_NAME=anova-checklist-review

# Only the gateway is published to the host. Preflight MUST pass before bind.
GATEWAY_BIND=127.0.0.1
GATEWAY_HOST_PORT=18080

# Optional absolute path for bind mounts; leave empty to use named volumes only.
# ACR_DATA_ROOT=

# --- Postgres (internal network only; not published) ---
POSTGRES_USER=acr
POSTGRES_PASSWORD=change-me-acr-pg
POSTGRES_DB=acr
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0

# --- API ---
DATABASE_URL=postgresql+asyncpg://acr:change-me-acr-pg@postgres:5432/acr
DATABASE_URL_SYNC=postgresql+psycopg2://acr:change-me-acr-pg@postgres:5432/acr
API_MEM_LIMIT=1g
API_CPU_LIMIT=1.0
AUTH_MODE=dev
DEV_API_TOKEN=dev-change-me
LOG_LEVEL=INFO

# --- Qdrant (internal) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_STANDARDS=standards_bgem3_v1
QDRANT_COLLECTION_PROJECT_DOCS=project_documents_bgem3_v1
QDRANT_MEM_LIMIT=1g
QDRANT_CPU_LIMIT=1.0

# --- Ollama (internal; LLM concurrency 1 in v1) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_MEM_LIMIT=4g
OLLAMA_CPU_LIMIT=2.0

# --- Embedding: BAAI/bge-m3 separate from Ollama ---
EMBEDDING_URL=http://embedding:8080
EMBEDDING_MODEL_ID=BAAI/bge-m3
# Pin a Hugging Face revision SHA when known on the deploy host.
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_MEM_LIMIT=4g
EMBEDDING_CPU_LIMIT=2.0

# --- Gateway resource limits ---
GATEWAY_MEM_LIMIT=128m
GATEWAY_CPU_LIMIT=0.25

# --- Preflight gates (deploy host) ---
PREFLIGHT_MIN_RAM_GB=8
PREFLIGHT_MIN_DISK_GB=20
PREFLIGHT_REQUIRE_GPU=0

# --- App paths inside containers ---
UPLOAD_DIR=/data/uploads
EXPORT_DIR=/data/exports
